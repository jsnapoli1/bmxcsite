# Hashed assets are immutable — the filename changes whenever the content
# does, so they can be cached indefinitely with no revalidation round-trip.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Every HTML entry point must be revalidated so new deploys are picked up
# immediately. The HTML is what names the hashed asset bundles, so a stale
# copy pins a browser to the previous deploy's JavaScript indefinitely —
# the assets it points at are themselves immutable, so nothing else in the
# chain will ever correct it.
#
# /admin and /admin.html are listed for the same reason as / — they were
# once omitted, and an admin kept running an old panel bundle after a
# deploy while the public site updated normally.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/admin
  Cache-Control: public, max-age=0, must-revalidate
/admin.html
  Cache-Control: public, max-age=0, must-revalidate
