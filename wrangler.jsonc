{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bmxcsite",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-18",
  "account_id": "9569781c361a80bd0b96dedbac0aca6d",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bmxc",
      "database_id": "18788aa1-60db-4026-803c-c556e0b1401e",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "CONTENT", "id": "e2441d00da964c31802c92de3e627a1b" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "bmxc-media" }
  ],
  "vars": {
    "TEAM_DOMAIN": "https://letssimplifai.cloudflareaccess.com",
    // The OpenShop worker backing the merch store. Its admin password is a
    // secret (SHOP_ADMIN_PASSWORD), not a var — see worker/shop/client.js.
    "SHOP_ORIGIN": "https://shop.bmxc.camp",
    "POLICY_AUD": "db4848e077aabcf690adc8aad5b389359a9fe034d9c924109774764e6d850efe"
  },

  // Custom domains. Declared here rather than set in the dashboard so that
  // CI deploys keep them and the config stays the source of truth.
  // Cloudflare manages the DNS records and certificates for these.
  "routes": [
    { "pattern": "bmxc.camp", "custom_domain": true },
    { "pattern": "www.bmxc.camp", "custom_domain": true }
  ]
}
