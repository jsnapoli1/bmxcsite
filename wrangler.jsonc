{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bmxcsite",
  "compatibility_date": "2026-08-18",
  "account_id": "9569781c361a80bd0b96dedbac0aca6d",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },

  // Custom domains. Declared here rather than set in the dashboard so that
  // CI deploys keep them and the config stays the source of truth.
  // Cloudflare manages the DNS records and certificates for these.
  "routes": [
    { "pattern": "bmxc.camp", "custom_domain": true },
    { "pattern": "www.bmxc.camp", "custom_domain": true }
  ]
}
