{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bmxcsite",
  "main": "./worker/index.js",
  "compatibility_date": "2026-08-18",
  "account_id": "9569781c361a80bd0b96dedbac0aca6d",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bmxc",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TEAM_DOMAIN": "https://bmxc.cloudflareaccess.com",
    "POLICY_AUD": ""
  },

  // Custom domains. Declared here rather than set in the dashboard so that
  // CI deploys keep them and the config stays the source of truth.
  // Cloudflare manages the DNS records and certificates for these.
  "routes": [
    { "pattern": "bmxc.camp", "custom_domain": true },
    { "pattern": "www.bmxc.camp", "custom_domain": true }
  ]
}
